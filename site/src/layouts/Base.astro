---
import { config } from "../config";
import { langs, langNames, prefix, t, type Lang } from "../i18n";

interface Props { lang: Lang; title: string; description?: string; page: string; lemon?: boolean }
const { lang, title, description, page, lemon = false } = Astro.props;
const d = t(lang);
const p = prefix(lang);
const path = page === "index" ? "" : `/${page}`;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "Dimit" ? "Dimit" : `${title} — Dimit`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={`${config.siteUrl}${prefix(l)}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${config.siteUrl}${path}`} />
    {lemon && <script src="https://app.lemonsqueezy.com/js/lemon.js" defer></script>}
    <style is:global>
      :root { color-scheme: light dark; --bg: #fff; --fg: #1a1a1a; --muted: #666; --line: #e5e5e5; --accent: #ff4d1a; --card: #f7f7f7; }
      @media (prefers-color-scheme: dark) { :root { --bg: #111; --fg: #eee; --muted: #9a9a9a; --line: #2a2a2a; --card: #1b1b1b; } }
      * { box-sizing: border-box; }
      body { margin: 0; font: 17px/1.55 -apple-system, "SF Pro Text", system-ui, sans-serif; background: var(--bg); color: var(--fg); }
      a { color: inherit; }
      header, main, footer { max-width: 820px; margin: 0 auto; padding: 0 20px; }
      header { display: flex; align-items: center; gap: 18px; padding-top: 18px; padding-bottom: 18px; flex-wrap: wrap; }
      header .brand { font-weight: 700; font-size: 20px; text-decoration: none; margin-right: auto; }
      header nav a { text-decoration: none; color: var(--muted); margin-left: 14px; }
      header nav a:hover { color: var(--fg); }
      .langs a { font-size: 14px; color: var(--muted); margin-left: 10px; text-decoration: none; }
      .langs a[aria-current] { color: var(--fg); font-weight: 600; }
      main { padding-top: 24px; padding-bottom: 48px; }
      h1 { font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 12px; }
      h2 { font-size: 24px; margin: 40px 0 12px; }
      h3 { font-size: 18px; margin: 20px 0 6px; }
      p.lead { font-size: 20px; color: var(--muted); margin: 0 0 24px; }
      .btn { display: inline-block; padding: 14px 22px; border-radius: 12px; background: var(--accent); color: #fff; font-weight: 600; text-decoration: none; }
      .btn.secondary { background: var(--card); color: var(--fg); }
      .btn.disabled { opacity: .5; pointer-events: none; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .card { background: var(--card); border-radius: 14px; padding: 18px; }
      .card h3 { margin-top: 0; }
      table { width: 100%; border-collapse: collapse; }
      td, th { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); vertical-align: top; }
      details { border-bottom: 1px solid var(--line); padding: 10px 0; }
      summary { cursor: pointer; font-weight: 600; }
      .muted { color: var(--muted); }
      .note { font-size: 15px; color: var(--muted); }
      footer { border-top: 1px solid var(--line); padding-top: 20px; padding-bottom: 40px; font-size: 14px; color: var(--muted); }
      footer nav a { margin-right: 14px; }
      code { font: 15px ui-monospace, SF Mono, Menlo, monospace; background: var(--card); padding: 1px 6px; border-radius: 6px; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={p || "/"}>Dimit</a>
      <nav>
        <a href={`${p}/download`}>{d.nav.download}</a>
        <a href={`${p}/faq`}>{d.nav.faq}</a>
        <a href={`${p}/help`}>{d.nav.help}</a>
        <a href={`${p}/science`}>{d.nav.science}</a>
        <a href={`${p}/changelog`}>{d.nav.changelog}</a>
      </nav>
      <span class="langs">
        {langs.map((l) => <a href={`${prefix(l)}${path}` || "/"} aria-current={l === lang ? "page" : undefined} lang={l}>{langNames[l]}</a>)}
      </span>
    </header>
    <main><slot /></main>
    <footer>
      <nav>
        <a href={`${p}/terms`}>{d.footer.terms}</a>
        <a href={`${p}/privacy`}>{d.footer.privacy}</a>
        <a href={`${p}/refund`}>{d.footer.refund}</a>
        <a href={config.myOrdersUrl} rel="noopener">{d.footer.myOrders}</a>
      </nav>
      <p>{config.legalEntity} · {d.footer.contact}: <a href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a> · <a href={config.telegram} rel="noopener">Telegram</a></p>
      <p>{d.footer.noTracking}</p>
    </footer>
  </body>
</html>
