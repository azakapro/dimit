---
import Base from "../layouts/Base.astro";
import { t, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<Base lang={lang} title={d.changelog.title} page="changelog">
  <h1>{d.changelog.title}</h1>
  {d.changelog.entries.map((e) => <section><h2>{e.version} <span class="muted" style="font-weight:400;font-size:16px">{e.date}</span></h2><ul>{e.notes.map((n) => <li>{n}</li>)}</ul></section>)}
</Base>
