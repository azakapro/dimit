---
import Base from "../layouts/Base.astro";
import { studies, t, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<Base lang={lang} title={d.science.title} page="science">
  <h1>{d.science.title}</h1>
  <p class="lead">{d.science.intro}</p>
  <h2>{d.science.studiesTitle}</h2>
  <ul>{studies.map((s) => <li>{s}</li>)}</ul>
  <p class="note">{d.science.noClaims}</p>
</Base>
