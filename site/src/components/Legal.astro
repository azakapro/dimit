---
import Base from "../layouts/Base.astro";
import { config } from "../config";
import { t, type Lang } from "../i18n";
const { lang, kind } = Astro.props as { lang: Lang; kind: "terms" | "privacy" | "refund" };
const d = t(lang)[kind];
// Text nodes only — no set:html — so a legal entity name containing `&`
// or `<` is escaped by Astro, and every {supportEmail} becomes a link.
const fragments = (s: string) => s.replaceAll("{legalEntity}", config.legalEntity).split("{supportEmail}");
---
<Base lang={lang} title={d.title} page={kind}>
  <h1>{d.title}</h1>
  {d.paras.map((s) => {
    const parts = fragments(s);
    return <p>{parts.map((frag, i) => <>{frag}{i < parts.length - 1 && <a href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>}</>)}</p>;
  })}
</Base>
