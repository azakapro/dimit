    "onboarding.1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two sliders, three presets, one button."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два ползунка, три режима, одна кнопка."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikki slayder, uch rejim, bitta tugma."
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block blue light. Stop the flicker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите синий свет. Остановите мерцание."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko'k nurni to'sing. Miltillashni to'xtating."
          }
        }
      }
    },
    "onboarding.2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots, recordings and calls keep their normal colours."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Screenshots, recordings and calls keep their normal colours."
          }
        },
        "uz": {
