        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrinshotlar oddiy qoladi"
          }
        }
      }
    },
    "onboarding.3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics, no tracking. Dimit connects to the internet only if you turn on update checks."
