    "main.pwm_safe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PWM‑Safe mode"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим без мерцания (PWM)"
          }
