    "banner.autobrightness": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic brightness can block colour changes on macOS 26. Turn it off in System Settings → Displays."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автояркость может блокировать изменение цвета в macOS 26. Отключите её в Системных настройках → Дисплеи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomatik yorqinlik macOS 26 da rang o'zgarishini bloklashi mumkin. Tizim sozlamalari → Displeylar bo'limida o'chiring."
          }
        }
      }
    },
