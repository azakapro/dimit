      }
    },
    "error.gamma_failed": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change display colours. Try Fallback mode in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить цвета дисплея. Попробуйте Резервный режим в Настройках."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Displey ranglarini o'zgartirib bo'lmadi. Sozlamalarda Zaxira rejimni sinab ko'ring."
          }
        }
      }
    },
    "fallback.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tints with an overlay instead of colour tables. Screenshots will look tinted in this mode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает экран слоем вместо цветовых таблиц. В этом режиме скриншоты тоже будут окрашены."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rang jadvallari o'rniga qatlam bilan bo'yaydi. Bu rejimda skrinshotlar ham rangli chiqadi."
          }
        }
      }
    },
    "fallback.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallback mode"
