    "main.pwm_safe.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the backlight at 100% and dims in software, so the screen never flickers. Uses slightly more battery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держит подсветку на 100% и уменьшает яркость программно — экран не мерцает. Немного больше расход батареи."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Orqa yoritishni 100% da ushlab, yorqinlikni dasturiy pasaytiradi — ekran umuman miltillamaydi. Batareya biroz ko'proq sarflanadi."
          }
        }
      }
    },
