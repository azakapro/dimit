    "warmth.zero_k.tip": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"0K\" is a name, not a physical temperature: at 0K only red light remains."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«0K» — это название, а не физическая температура: при 0K остаётся только красный свет."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "\"0K\" — bu nom, fizik harorat emas: 0K da faqat qizil nur qoladi."
          }
        }
      }
    },
