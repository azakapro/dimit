<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Dimit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Dimit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Menu-bar-only: no Dock icon, no App Switcher entry. CLAUDE.md §1.1. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Dimit</string>
	<!-- No sandbox, no special entitlements: CLAUDE.md §1.5 forbids Accessibility/
	     Screen Recording/admin. We are not an App Store app. -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- CLAUDE.md §3.8/§8: only shown if the user taps "Use my location" in
	     the Sunset->Sunrise schedule (LocationProvider.swift is the one call
	     site). Both keys present since Apple's own guidance on which one
	     macOS actually consults has changed across releases; base (English)
	     text here, uz/ru in Resources/{uz,ru}.lproj/InfoPlist.strings — Info.plist
	     values aren't part of the String Catalog mechanism. -->
	<key>NSLocationUsageDescription</key>
	<string>Dimit uses your location only to compute today's sunrise and sunset time for the Sunset→Sunrise schedule. Nothing is sent anywhere.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dimit uses your location only to compute today's sunrise and sunset time for the Sunset→Sunrise schedule. Nothing is sent anywhere.</string>
	<!-- Sparkle (C7, ARCHITECTURE.md §8). SUEnableAutomaticChecks is NO so
	     Sparkle never shows its own "check automatically?" prompt and never
	     schedules a check on its own: UpdateController.swift sets
	     automaticallyChecksForUpdates from the user's opt-in
	     (AppState.updateChecksEnabled, default off — CLAUDE.md §1.2). The
	     public EdDSA key's private half lives in the maintainer's login
	     Keychain and is never committed (scripts/make_appcast.sh). -->
	<key>SUFeedURL</key>
	<string>https://dimit.uz/updates/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUPublicEDKey</key>
	<string>cav7+wp1pUffwzeR1+TvwDdc3NIaEB34GR71ZF3QCd4=</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>uz</string>
		<string>ru</string>
	</array>
</dict>
</plist>
