# Xcode — project.yml is the source of truth (XcodeGen, see scripts/bootstrap.sh);
# the generated .xcodeproj is never committed, so there is never a merge
# conflict in a generated pbxproj. Run scripts/bootstrap.sh after cloning or
# after editing project.yml.
/Dimit.xcodeproj/
build/
DerivedData/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
# Broader xcuserdata coverage kept as defense in depth (code review on C1):
# the /Dimit.xcodeproj/ line above only protects that one generated
# directory; this catches xcuserdata in any *other* .xcodeproj or
# .xcworkspace that might exist someday (e.g. a workspace wrapping this
# project plus something else) without needing another edit here.
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods (explicitly unused, but just in case)
Pods/

# Secrets
*.p8
*.p12
.env
.env.*
server/.dev.vars
server/.wrangler/

# Site
site/node_modules/
site/dist/
site/.astro/

# macOS
.DS_Store

# Scratch
*.orig

# Claude Code session tooling (launch configs, locks) — per machine, not project
.claude/
